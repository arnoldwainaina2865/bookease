# BookEase - Environment Configuration

# Copy this file to .env before running the application.
# Generate each secret independently using:
# python -c "import secrets; print(secrets.token_hex(32))"

# Flask security
SECRET_KEY=

# JWT authentication
JWT_SECRET_KEY=

# Database connection
DATABASE_URL=sqlite:///bookease.db

# Password recovery
FRONTEND_URL=http://localhost:5173

# SMTP email delivery
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
# Rate limiting storage
RATELIMIT_STORAGE_URI=memory://
