
# ==========================================
# BookEase - Git Ignore Configuration
# ==========================================

# Environment variables and secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python virtual environments
venv/
.venv/
env/
ENV/

# Python cache and compiled files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Flask instance and local databases
instance/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Python packaging
*.egg-info/
.eggs/
build/
dist/

# Test coverage
.coverage
.coverage.*
htmlcov/

# Frontend dependencies and build files
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE and editor settings
.vscode/
.idea/
*.swp
*.swo

# Operating system files
.DS_Store
Thumbs.db
Desktop.ini

# Temporary files
*.tmp
*.bak
